# Generated model artifacts (written to ./models at runtime)
/models/

# The run store: `mlflow.db` indexes the runs, `mlruns/` holds the artifacts every mode
# writes into. Local-only, and a generated output rather than a source input. Unanchored
# because both paths are relative to the working directory, so a run launched from a
# subdirectory leaves them there instead.
mlflow.db
mlruns/

# In-flight pipeline state: the log of a run still going, which the dashboard tails. Not an
# artifact of a finished run, which is why it is not in the store.
var/

# Byte-compiled Python
__pycache__/

# Packaging (uv build / hatchling)
/build/
/dist/
*.egg-info/

# Test coverage — pytest runs with --cov by default, see pyproject.toml addopts
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/

# Type checker / linter caches
.mypy_cache/
.ruff_cache/

# Jupyter (notebooks/)
.ipynb_checkpoints

# Environments
.venv
.env

# Deploy-target-local overrides. These match nothing on a dev machine by
# design — they exist only on the VPS, where the infra is machine-specific.
docker-compose.override.yml

# Django. No database today (sessions are signed cookies), but these are cheap
# insurance if that ever changes.
local_settings.py
db.sqlite3

# OS
.DS_Store

# Project data caches
data/raw/*
!data/raw/.gitkeep
data/interim/*
data/processed/*
!data/processed/.gitkeep

# LaTeX
memoria/*.pdf
memoria/*.log
memoria/*.aux
memoria/*.toc
memoria/*.lof
memoria/*.lot
memoria/*.out
memoria/*.synctex.gz
memoria/*.bbl
memoria/*.blg
memoria/.build/*
!memoria/.build/.gitkeep
memoria/figures/eda/*
!memoria/figures/eda/.gitkeep


# Claude Code. Session state and worktrees are local, but launch.json is shared
# project configuration (how to start the dev server), so it stays tracked.
# Note the trailing /* — git cannot re-include a file inside an ignored
# directory, so `.claude/` followed by a negation would not work.
.claude/*
!.claude/launch.json

# Django collectstatic output
staticfiles/

# Scratch and ad-hoc output directories
tmp/*
output/*
