# Environment for the Django dashboard. Copy to .env and fill in.
#
# The dashboard has no database: sessions are signed cookies, so rotating
# DJANGO_SECRET_KEY logs everyone out. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=forecasting.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://forecasting.example.com

# Single operator account. An empty AUTH_PASSWORD disables login entirely.
AUTH_USERNAME=
AUTH_PASSWORD=

# Safari drops Secure cookies over http://localhost, so local dev sets this to
# false. Production must leave it true.
COOKIE_SECURE=true
